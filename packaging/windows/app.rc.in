// Application icon for GOST-Writer (Windows)
#include <winver.h>

IDI_ICON1 ICON "@ICON_PATH@"

1 VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEOS 0x40004L
 FILETYPE 0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "GOST-Writer — GOST R 2.105-2019 & 2.106-2019 Document Editor"
            VALUE "ProductName", "GOST-Writer"
            VALUE "ProductVersion", "1.0.0"
            VALUE "OriginalFilename", "marked-text-down.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
