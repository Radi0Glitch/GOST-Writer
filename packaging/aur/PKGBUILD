# Maintainer: Radi0Glitch <radioglitch at github>

pkgname=gost-writer-git
pkgver=r1.0.0
pkgrel=1
pkgdesc="Visual WYSIWYG Markdown editor for GOST R 2.105-2019 & GOST R 2.106-2019 (ESKD) documents"
arch=('x86_64')
url="https://github.com/Radi0Glitch/GOST-Writer"
license=('MIT')
depends=('sdl3' 'sdl3_ttf')
makedepends=('git' 'meson' 'ninja')
optdepends=(
  'pandoc: export to DOCX/HTML/ODT/EPUB'
  'typst: direct GOST PDF export engine'
)
provides=('gost-writer' 'marked-text-down')
conflicts=('gost-writer' 'gost-writer-debug' 'marked-text-down' 'marked-text-down-debug')
source=("$pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$pkgname"
  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd "$pkgname"
  arch-meson build
  meson compile -C build
}

package() {
  cd "$pkgname"
  meson install -C build --destdir "$pkgdir"
  install -Dm644 LICENSE.md "$pkgdir/usr/share/licenses/$pkgname/LICENSE.md"
}
